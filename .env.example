MONGODB_USERNAME='<mongodb_username>'
MONGODB_PASSWORD='<mongodb_password>'
MONGODB_URI='mongodb+srv://<mongodb_username>:<mongodb_password>@<cluster>.abcd.mongodb.net/<DB_name>'
